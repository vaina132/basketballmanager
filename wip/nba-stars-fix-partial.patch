diff --git a/src/world/nba-free-agency.ts b/src/world/nba-free-agency.ts
new file mode 100644
index 0000000..f4783b3
--- /dev/null
+++ b/src/world/nba-free-agency.ts
@@ -0,0 +1,100 @@
+import type { SeasonState } from '../domain/season';
+import type { WorldContext } from '../domain/world';
+import { isCapClub } from './club-roster-policy';
+import { NBA_MID_LEVEL, nbaMaximumWage, usdToCents } from './nba-cap';
+import { getCareerPlayerAge, type CareerPlayerContext } from './player-catalog';
+import { contractForSeason } from './employment-policy';
+import { addMarketDays, MARKET_WINDOW_DAYS } from './market-policy';
+import { dateForRound } from './season';
+import { seasonRounds } from './career-world';
+import { nbaValue } from './nba-moves';
+
+/**
+ * Format 103 (new careers in worlds with the NBA's money rules, `world.nbaFreeAgency`): NBA free agency keeps the
+ * league's stars, as the real league does (measured on the live pack, NBA alone, seed 7: 17 players rated 85+ were
+ * unsigned after the first season and 15 players rated 88+ left the world, two of them 99s).
+ *
+ * Why stars left before (formats 93-102):
+ * - A star's ask (his wage, +15% for a Star role, +5-10% for a longer term, +premium after a refused contract request)
+ *   was above the most an NBA contract may pay him at his age (25/30/35% of the cap), so no club could ever sign him:
+ *   his club's in-season renewal failed, the refusal added a premium, and every offseason quote failed.
+ * - Re-signing a star took most clubs past their owner's payroll ceiling, which Bird rights did not pass.
+ * - Players still unsigned when the season opened left the world, lowest rated first while more than 15 a club
+ *   remained: with stars unsigned, everyone unsigned left.
+ *
+ * Rules with the marker:
+ * - **Asks within the maximum.** A player never asks an NBA club more than his maximum contract at his age (every
+ *   demand: one season or longer, after a refused request, the club's role premium).
+ * - **Bird rights for the best players.** Re-signing the club's own player rated `birdStarLevel` or more (Bird rights)
+ *   may go past the owner's payroll ceiling up to `birdStarCeilingUsd` (owners pay the tax to keep their stars).
+ * - **Falling asks.** A player without a contract for next season asks at most the non-taxpayer mid-level exception
+ *   from `midLevelAfterDays` days into the offseason window (every club over the cap can still sign him once), and his
+ *   minimum salary in the last days as before (format 92).
+ * - **Departures.** In NBA-only worlds, players still unsigned when the season opens leave only below `keepLevel` or
+ *   (from `keepMaxAge`) below `keepVeteranLevel`; better players stay as free agents for the next window.
+ *
+ * [E] Every value below is the game's estimate; the CBA's figures are in `nba-cap.ts`.
+ */
+export const NBA_FREE_AGENCY_RULES = Object.freeze({
+  model: 'nba-free-agency-1' as const,
+  /** [E] Own players at this overall or above may be re-signed past the owner's ceiling (about a club's best two or three). */
+  birdStarLevel: 80,
+  /** [E] The payroll a club may reach re-signing such a player: the second apron of the 2026-27 cap ($222.0M). */
+  birdStarCeilingUsd: 222_000_000,
+  /** [E] Days into the offseason window from which an unsigned player asks at most the mid-level exception. */
+  midLevelAfterDays: 7,
+  /** [E] NBA-only worlds: unsigned players at this overall or above stay in the world as free agents (an NBA club's 11th man)... */
+  keepLevel: 65,
+  /** [E] ...but from this age only at `keepVeteranLevel` or above (a rotation player). */
+  keepMaxAge: 34,
+  keepVeteranLevel: 80,
+});
+
+/** Whether a career's world uses format 103's NBA free agency. */
+export const usesNbaFreeAgency = (context: WorldContext | undefined): boolean => context?.world?.nbaFreeAgency === true && context.world.nba?.cap === 'nba-cap-1';
+
+/**
+ * Format 103: the most a player asks an NBA club (his maximum contract at his age on the context's date), or null when
+ * no cap applies (older careers, European clubs).
+ */
+export type NbaFreeAgencyContext = CareerPlayerContext & { employment?: SeasonState['employment']; status?: SeasonState['status'] };
+
+/** The payroll (euro cents) a club may reach re-signing one of its best players with Bird rights. */
+export const NBA_BIRD_STAR_CEILING = usdToCents(NBA_FREE_AGENCY_RULES.birdStarCeilingUsd);
+
+/**
+ * Whether a player without a contract for next season is far enough into the offseason window to ask at most the
+ * mid-level exception. Depends only on the date, the season and his contracts, so a save's replay decides it the same way.
+ */
+function midLevelAsk(context: NbaFreeAgencyContext, playerId: string): boolean {
+  if (context.status !== 'complete' || !context.employment || context.seasonNumber === undefined || !context.date) return false;
+  const opensOn = dateForRound(seasonRounds(context), context.seasonNumber);
+  if (context.date < addMarketDays(opensOn, NBA_FREE_AGENCY_RULES.midLevelAfterDays) || context.date > addMarketDays(opensOn, MARKET_WINDOW_DAYS)) return false;
+  return !contractForSeason(context.employment, playerId, context.seasonNumber + 1);
+}
+
+export function nbaDemandCap(context: NbaFreeAgencyContext, clubId: string | undefined, playerId: string): number | null {
+  if (!clubId || !usesNbaFreeAgency(context) || !isCapClub(context, clubId)) return null;
+  let age: number | null = null;
+  try { age = context.date ? getCareerPlayerAge(context, playerId, context.date) : null; } catch { age = null; }
+  const maximum = nbaMaximumWage(age);
+  return midLevelAsk(context, playerId) ? Math.min(maximum, NBA_MID_LEVEL) : maximum;
+}
+
+/** A demand limited by `nbaDemandCap` (unchanged without a cap). */
+export function cappedNbaDemand(context: NbaFreeAgencyContext, clubId: string | undefined, playerId: string, demand: number): number {
+  const cap = nbaDemandCap(context, clubId, playerId);
+  return cap !== null && cap < demand ? cap : demand;
+}
+
+/** Format 103: whether re-signing this player with Bird rights may pass the owner's ceiling (his overall today). */
+export function nbaBirdStar(context: CareerPlayerContext, playerId: string): boolean {
+  return usesNbaFreeAgency(context) && nbaValue(context, playerId) >= NBA_FREE_AGENCY_RULES.birdStarLevel;
+}
+
+/** Format 103 (NBA-only worlds): whether a player still unsigned when the season opens leaves the world (nobody would sign him). */
+export function nbaUnsignedLeaves(context: CareerPlayerContext, playerId: string): boolean {
+  if (!usesNbaFreeAgency(context)) return true;
+  const value = nbaValue(context, playerId), age = context.date ? getCareerPlayerAge(context, playerId, context.date) ?? 0 : 0;
+  return value < NBA_FREE_AGENCY_RULES.keepLevel || age >= NBA_FREE_AGENCY_RULES.keepMaxAge && value < NBA_FREE_AGENCY_RULES.keepVeteranLevel;
+}
