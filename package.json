{
  "name": "basketball-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "European basketball management simulation — design and first engine foundation",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "node scripts/euroleague-data.mjs",
    "data:api-sports-probe": "node scripts/api-sports-probe.mjs",
    "data:import": "node scripts/real-data-import.mjs",
    "data:identities": "node scripts/real-data-identities.mjs",
    "data:ratings": "node scripts/real-data-ratings.mjs",
    "data:pack": "node scripts/real-data-pack.mjs",
    "data:verify": "node scripts/real-data-verify.mjs",
    "benchmark:match": "node scripts/benchmark-match.mjs",
    "benchmark:saves": "node scripts/benchmark-saves.mjs",
    "benchmark:career": "node scripts/benchmark-career.mjs",
    "fixtures:capture": "node scripts/capture-season-fixtures.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
